NODE_ENV=development
PORT=5000

# Only the literal value true enables this local safety override. It suppresses
# startup seeding/jobs/WhatsApp and outbound email/WhatsApp notifications.
SAFE_LOCAL_PRODUCTION_MODE=false

# MongoDB
# Required. Production must point to a KA-only database, not a Kanz/legacy DB.
# Use a replica set for full MongoDB transaction support.
MONGO_URI=mongodb://localhost:27017/ka-platform

# Test database override
# Optional. Jest globalSetup creates and injects a MongoMemoryReplSet URI when
# this is not provided.
MONGO_TEST_URI=

# JWT and password hashing
# Required in every runtime except tests, where globalSetup injects test values.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Frontend, redirects, links, and CORS
# ALLOWED_ORIGINS is production-critical. In production the app refuses to
# start if this is empty.
FRONTEND_URL=http://localhost:5173
FRONTEND_VERIFY_REDIRECT_URL=http://localhost:5173/email-verified
APP_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth
# Optional. /api/auth/google returns 503 unless both ID and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Android Credential Manager ID-token audience. Use the existing OAuth web/server
# client ID; do not put a client secret in the Android app.
GOOGLE_WEB_CLIENT_ID=

# Firebase Admin (server-only). Leave blank to keep database notifications
# working while Android FCM delivery is disabled. Store real values in a secret
# manager; FIREBASE_PRIVATE_KEY supports escaped newline characters.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMTP email
# Required only for email verification and email OTP 2FA delivery.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ka.example

# Exchange rate sync
# Used by src/services/exchangeRateSync.service.js. The cron module exists but
# is not started automatically by src/server.js in the current implementation.
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest?base=USD
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_TIMEOUT_MS=10000

# Order creation and provider polling tuning
ORDER_CREATION_TRANSACTIONS=
POLL_BATCH_LIMIT=100
POLL_MAX_BATCH_SIZE=50
POLL_MAX_CONCURRENT=3
POLL_INTER_BATCH_DELAY_MS=0

# Provider catalog and live-price cache tuning
SYNC_UPSERT_CONCURRENCY=10
PROVIDER_PRICE_CACHE_TTL_MS=300000

# Target requests
# Disabled by default. Set to true only for a legacy deployment that has not
# configured admin paymentGroups yet. When disabled, Target requests fail closed
# if no active configured payment methods exist.
TARGET_PAYMENT_LEGACY_FALLBACK_ENABLED=false

# Referral commissions
# Default commission percentage applied to eligible referral deposit approvals
# when the referrer has no per-user override. Explicit per-user 0 disables
# commission record creation for that referrer.
REFERRAL_DEFAULT_COMMISSION_PERCENT=1

# Legacy Royal Crown shim fallback only
# Current provider adapters normally read credentials from Provider records in
# MongoDB: baseUrl plus apiToken/apiKey. These two variables are read only by
# src/modules/providers/royalCrownProvider.js.
PROVIDER_BASE_URL=
PROVIDER_API_TOKEN=

# Legacy provider placeholders
# These names are kept as operator notes for provider records, but the current
# code does not read them directly.
ROYAL_CROWN_API_URL=https://royal-croown.com
ROYAL_CROWN_API_TOKEN=
TOROSFON_API_URL=https://torosfon.com
TOROSFON_API_TOKEN=
ALKASR_API_URL=https://alkasr-vip.com
ALKASR_API_TOKEN=

# Receipt analyzer
# Fast image checks are always applied to uploaded deposit receipt images.
# OCR is optional and disabled by default because it is CPU-heavy.
RECEIPT_ANALYZER_ENABLE_OCR=false
RECEIPT_ANALYZER_MIN_ENTROPY=1.0
RECEIPT_ANALYZER_BLACK_MEAN_MAX=8
RECEIPT_ANALYZER_WHITE_MEAN_MIN=247
RECEIPT_ANALYZER_SOLID_STDDEV_MAX=2.5
RECEIPT_ANALYZER_LOW_ENTROPY_STDDEV_MAX=3.2
RECEIPT_ANALYZER_MAX_INPUT_PIXELS=40000000
RECEIPT_ANALYZER_OCR_TIMEOUT_MS=3500
RECEIPT_ANALYZER_OCR_RESIZE_WIDTH=1200
RECEIPT_ANALYZER_OCR_MIN_KEYWORD_MATCHES=1
RECEIPT_ANALYZER_OCR_KEYWORDS=vodafone,cash,transfer,success

# Vodafone Cash SMS bridge (Android SMS Forwarder). Keep auto approval disabled
# until real KA device messages have been reviewed and matching has been verified.
VODAFONE_SMS_BRIDGE_ENABLED=true
VODAFONE_SMS_HMAC_SECRET=
VODAFONE_SMS_AUTO_APPROVE=false
VODAFONE_SMS_INSTAPAY_AUTO_APPROVE=false
VODAFONE_SMS_DEVICE_ID=ka-vf-01
VODAFONE_SMS_MAX_EVENT_AGE_MINUTES=1440

# WhatsApp admin notifications
# Optional. Number should be international digits only, without + or spaces.
ADMIN_NOTIFICATION_NUMBER=
WHATSAPP_CLIENT_ID=admin-notifications
WHATSAPP_AUTH_DATA_PATH=
WHATSAPP_CACHE_DATA_PATH=
WHATSAPP_RECONNECT_DELAY_MS=5000
WHATSAPP_AUTO_INIT=true

# Startup controls
# Use false only for safe local/staging startup checks that must not run
# background provider polling, fulfillment polling, or WhatsApp initialization.
BACKGROUND_JOBS_ENABLED=true
